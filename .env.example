# ==========================================
# APP
# ==========================================
APP_NAME=ClassyBattle
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-64-char-secret

# ==========================================
# DATABASE (Supabase Postgres)
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ==========================================
# JWT
# ==========================================
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# OTP
# ==========================================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# ==========================================
# SUPABASE
# ==========================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=classybattle-assets

# ==========================================
# BREVO (Email)
# ==========================================
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@classybattle.com
BREVO_SENDER_NAME=ClassyBattle

# ==========================================
# FIREBASE (Push Notifications)
# ==========================================
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=classybattle-app

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=["http://localhost:3000"]

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT=10/minute
OTP_RATE_LIMIT=5/minute
# REQUIRED in production (multi-worker) so all workers share one rate-limit
# counter per IP. Without this, effective limits are (limit x worker count).
# Leave empty for local single-worker dev only.
REDIS_URL=redis://localhost:6379/0

# ==========================================
# PROXY / CLIENT IP
# ==========================================
# Number of trusted reverse-proxy hops in front of the app (Render's edge
# proxy = 1). Do not raise this unless you actually add another proxy hop.
TRUSTED_PROXY_COUNT=1

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO

# ==========================================
# SENTRY
# ==========================================
# Leave empty to disable Sentry (no startup error).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ==========================================
# API DOCUMENTATION
# ==========================================
# Leave unset to auto-disable Swagger/Redoc/OpenAPI JSON when
# APP_ENV=production and auto-enable everywhere else. Set explicitly
# (true/false) to override that default for this deployment.
# ENABLE_API_DOCS=false

# ==========================================
# TELEGRAM ADMIN BOT
# ==========================================
# Leave TELEGRAM_BOT_TOKEN empty to disable the bot entirely.
TELEGRAM_BOT_TOKEN=
# Code a chat must send via "/start <code>" to receive deposit/withdrawal
# notifications and use the Confirm/Decline buttons.
TELEGRAM_AUTH_CODE=CB1245
# Random secret string, mixed into the webhook path + verified via
# Telegram's X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# Email of the admin user the bot acts as when approving/rejecting deposits.
TELEGRAM_BOT_ADMIN_EMAIL=axl200ff@gmail.com
